# Template for local secret settings. Copy this file to .env and fill it in:
#   cp .env.example .env
# Never commit .env; it is excluded by .gitignore.

# A long random value that protects logins and forms. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# true = detailed error pages (only on your own Mac). Use false for any shared use.
DEBUG=true
